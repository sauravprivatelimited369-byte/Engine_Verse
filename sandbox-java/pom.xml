<?xml version="1.0" encoding="UTF-8"?>
<!--
  EngineVerse Java sandbox.

  A standalone JVM that the Python web server shells out to (see
  backend/engineverse/judge/java_bridge.py). It deliberately has NO runtime
  dependencies: JSON is parsed by our own reader so the artifact is a single
  self-contained jar and the attack surface stays as small as possible.

  Build:  mvn -q -DskipTests package   ->   target/engineverse-sandbox.jar
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.engineverse</groupId>
  <artifactId>engineverse-sandbox</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>EngineVerse Sandbox</name>
  <description>Isolated runner for learner-submitted code.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>engineverse-sandbox</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.engineverse.sandbox.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
