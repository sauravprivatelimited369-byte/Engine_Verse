# Copy to .env on the OTP service host (or set in your host's dashboard).
# NEVER commit real values. Generate OTP_SECRET: python3 -c "import secrets;print(secrets.token_hex(32))"
OTP_SECRET=

# --- Email (free): Gmail SMTP with an App Password -------------------------
# Google Account -> Security -> 2-Step Verification -> App passwords.
# URL-encode @ as %40 in the username. This sends REAL mail to users' inboxes.
SMTP_URL=smtps://you%40gmail.com:xxxx%20xxxx%20xxxx%20xxxx@smtp.gmail.com:465/
MAIL_FROM=EngineVerse <you@gmail.com>

# --- SMS (pick ONE; all optional if you only want email OTP) ---------------
# Twilio (international, has a trial): https://www.twilio.com/try-twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx
# MSG91 (India, needs a DLT-approved template): https://msg91.com
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# Or any gateway that accepts POST {"to":"+91...","body":"..."}:
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=

# Browser origins allowed to call this service (your Pages site):
OTP_ALLOWED_ORIGINS=https://authorsauravkushwaha.github.io,http://localhost:8000
OTP_DB=./otp.sqlite3
PORT=8000
