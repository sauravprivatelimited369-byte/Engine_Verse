# ===========================================================================
#  EngineVerse configuration
#  Copy to `.env` and edit. NEVER commit `.env`.
#  The core app is self-hosted. An optional Android download and encrypted
#  GitHub backup use third-party delivery/storage only when you opt into them.
# ===========================================================================

# 32+ random bytes, used for session MACs, CSRF tokens, and authenticator seals.
# Rotating it signs everyone out and makes existing authenticator seals unreadable.
# Generate:  python3 -c "import secrets;print(secrets.token_hex(32))"
ENGINEVERSE_SECRET=

# Where the app is served from (canonical URLs, cookie Secure flag).
ENGINEVERSE_SITE_URL=http://localhost:8000

# --- Database --------------------------------------------------------------
# SQLite (default, zero setup):
ENGINEVERSE_DB_PATH=./data/engineverse.sqlite
# PostgreSQL (production, billions of rows - see db/postgres/README.md):
# ENGINEVERSE_DB_URL=postgresql://engineverse:secret@127.0.0.1:5432/engineverse

# --- Sign-in codes and outbound mail ---------------------------------------
# Password-only sign-in is the default, and it needs no mail transport: the
# password is verified against a scrypt hash, the session cookie is HttpOnly
# and SameSite, and repeated failures lock the account temporarily.
#
# A second factor is available per account without any of this: enrol an
# authenticator app under Settings -> Security and every sign-in then asks for
# a six-digit code from it.
#
# Set this to `required` to demand a *delivered* code at every password sign-in
# instead. That mode needs ENGINEVERSE_SMTP_URL or ENGINEVERSE_SMS_URL: with
# neither configured there is nowhere to send the code, so production refuses
# to start and a development instance shows the code on the page once.
ENGINEVERSE_LOGIN_OTP=disabled

# Who can use the site. "required" (the default) puts every page behind an
# account: signed-out visitors are sent to /login and returned to the page they
# asked for. Only sign-in, registration, password recovery, the legal pages and
# certificate verification stay open. "optional" allows anonymous browsing of
# the public catalogue.
ENGINEVERSE_SIGNIN=required

# Only after a signed Android GitHub Release exists; this is optional. On a
# public deployment use deploy/.env, which also forwards TWA package/fingerprint.
# ENGINEVERSE_APK_URL=https://github.com/sauravprivatelimited369-byte/Engine_Verse/releases/download/android-v1.0.0/EngineVerse.apk
# ENGINEVERSE_TWA_PACKAGE=org.example.engineverse
# ENGINEVERSE_TWA_SHA256=AA:BB:... (32 colon-separated bytes)

# Operator-run SMS gateway. It receives POST JSON {"to":"+...","body":"..."}.
# Userinfo password is sent as Authorization: Bearer and stripped from the URL.
# ENGINEVERSE_SMS_URL=https://gateway.internal/messages

# Empty means this instance has no mail transport. Without it, password reset
# cannot deliver a link, so self-service reset is reported as unavailable rather
# than the link being shown in the page -- showing it would let anyone request a
# reset for a victim's address and read the live link back out of the response.
# ENGINEVERSE_SMTP_URL=smtp://user:password@mail.internal:587/?starttls=1
# Gmail example: use a dedicated account and a two-step-verification app password.
# URL-encode the @ and hyphens in the credentials.
# ENGINEVERSE_SMTP_URL=smtps://engineverse%40example.com:xxxx%2Dxxxx%2Dxxxx%2Dxxxx@smtp.gmail.com:465/?starttls=0
# ENGINEVERSE_MAIL_FROM=EngineVerse <no-reply@example.org>
# When this is set, Settings can email a confirmation link. The link is not
# shown in the page. Without it, addresses stay unconfirmed and sign-in works.

# How strictly a *new* address is checked for being able to receive mail.
# Syntax, near-miss freemail domains (gmial.com) and temporary inboxes are
# always refused, whatever this says; this knob only controls the DNS lookup.
#   off      - never ask DNS. The only sane setting where outbound UDP is blocked.
#   fallback - ask DNS at sign-up only, and believe the address when no resolver
#              answers. This is the default outside test/ci.
#   mx       - ask DNS and refuse a domain that publishes no mail servers.
#              Strictest, and it will refuse a real address whose domain has a
#              misconfigured or firewall-detected MX record.
# Login and password recovery never refuse on this: an account whose domain lost
# its mail servers years later must still be able to get in and get a reset link.
# ENGINEVERSE_EMAIL_DELIVERABILITY=fallback

# DEVELOPMENT ONLY. Shows the reset link in the page instead of emailing it.
# Refused outright when ENGINEVERSE_ENV=production. Leave this unset anywhere a
# real user can reach the site.
# ENGINEVERSE_REVEAL_RESET_TOKEN=0

# --- Code execution --------------------------------------------------------
# Development default. Production refuses auto, python and java: those run
# learner code on this server. Use disabled, or judge0 with a URL you operate.
# auto   -> use the Java sandbox when a JDK is available, else the built-in runner
# python -> force the built-in runner
# java   -> force the Java sandbox service (requires JAVA_HOME)
# disabled -> refuse every submission
# judge0 -> forward to a self-hosted Judge0 API
ENGINEVERSE_JUDGE=auto
ENGINEVERSE_JUDGE_TIMEOUT_MS=5000
ENGINEVERSE_JUDGE_MEMORY_KB=524288
# ENGINEVERSE_JUDGE0_URL=http://127.0.0.1:2358
# ENGINEVERSE_JUDGE0_KEY=

# Java sandbox (only needed for ENGINEVERSE_JUDGE=java)
# JAVA_HOME=/usr/lib/jvm/java-21
# ENGINEVERSE_JAVA_SANDBOX_JAR=./sandbox-java/target/engineverse-sandbox.jar

# --- AI tutor --------------------------------------------------------------
# Leave empty to run in grounded-retrieval mode (answers are assembled only
# from EngineVerse content, so it can never invent syllabus facts).
# ENGINEVERSE_AI_KEY=
# ENGINEVERSE_AI_URL=

# Leave unset. X-Forwarded-For is ignored unless this is on, and even then only
# when the TCP peer is loopback or private. Do not turn it on because a compose
# port is published on 127.0.0.1; there is no proxy in that file. A public peer
# that sends the header is still the client.
# ENGINEVERSE_TRUST_PROXY=0

# --- ElevenLabs voice reader and voice tutor (optional) --------------------
# Off unless you explicitly opt in. Nothing is sent to ElevenLabs while this is
# unset, and the written site works exactly as before.
#
# The key is a SERVER secret. It must never appear in backend/static, a
# template, the exported site/ directory, the Android app or a Git commit.
# Create it at https://elevenlabs.io/ -> Profile -> API keys, with the
# narrowest scope and a usage limit. See docs/ELEVENLABS_INTEGRATION.md.
# ENGINEVERSE_ELEVENLABS_ENABLED=0
# ELEVENLABS_API_KEY=
#
# One or more approved voices per language, comma-separated. Only the IDs
# listed here can ever be used; the browser cannot name another voice.
# Labels are optional picker names, in the same order as the IDs.
# ELEVENLABS_TTS_VOICE_ID_EN=
# ELEVENLABS_TTS_VOICE_NAME_EN=English voice
# ELEVENLABS_TTS_VOICE_ID_HI=
# ELEVENLABS_TTS_VOICE_NAME_HI=Hindi voice
# A model that speaks both English and Hindi.
# ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
#
# Conversational AI agent for the spoken tutor on /tutor. Empty means the page
# explains that no agent is configured instead of pretending a session exists.
# ELEVENLABS_AGENT_ID=
#
# Longest text accepted for one synthesis request (200-3000 characters). The
# browser splits long articles into chunks of this size.
# ENGINEVERSE_VOICE_MAX_CHARS=1200
# Upstream timeout in seconds.
# ENGINEVERSE_VOICE_TIMEOUT_SECONDS=30
# Extra browser origins allowed to call the public /api/voice/* endpoints, in
# addition to this site's own origin and the project's GitHub Pages origin.
# Exact scheme + host + port, comma-separated. Never use "*".
# ENGINEVERSE_VOICE_ORIGINS=https://sauravprivatelimited369-byte.github.io
#
# PUBLIC, non-secret: used only by scripts/export_pages.py to bake the FastAPI
# voice API origin into the static GitHub Pages copy. Leave it unset and the
# export ships without voice controls instead of broken ones.
# ENGINEVERSE_VOICE_API_URL=

HOST=0.0.0.0
PORT=8000
